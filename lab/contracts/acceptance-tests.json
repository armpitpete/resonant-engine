{
  "schema": "resonant-engine-lab-acceptance/v1",
  "tests": [
    {
      "id": "A01",
      "name": "Pluck",
      "preset": "pluck",
      "duration_ms": 2200,
      "expected": "Clean audible transient excitation with resonant decay, finite output, no click or protected state.",
      "program": [
        {"op": "set_parameter", "at_ms": 0, "id": 105, "value": 0.8},
        {"op": "note_on", "at_ms": 0, "note": 60, "velocity": 0.85},
        {"op": "note_off", "at_ms": 80, "note": 60},
        {"op": "mark", "at_ms": 700, "label": "decay"},
        {"op": "panic", "at_ms": 2100}
      ]
    },
    {
      "id": "A02",
      "name": "Sustained pipe",
      "preset": "sustained-pipe",
      "duration_ms": 4800,
      "expected": "Stable sustained resonance with continuous drive, continuous timbre and controlled release.",
      "program": [
        {"op": "note_on", "at_ms": 0, "note": 57, "velocity": 0.75},
        {"op": "mark", "at_ms": 2200, "label": "sustain", "note": 57},
        {"op": "note_off", "at_ms": 3600, "note": 57},
        {"op": "mark", "at_ms": 4300, "label": "release"},
        {"op": "panic", "at_ms": 4700}
      ]
    },
    {
      "id": "A03",
      "name": "Damping sweep",
      "preset": "sustained-pipe",
      "duration_ms": 6400,
      "expected": "Continuous and reversible decay/bandwidth change without discontinuity or numerical failure.",
      "program": [
        {"op": "note_on", "at_ms": 0, "note": 60, "velocity": 0.75},
        {"op": "sweep_parameter", "at_ms": 200, "id": 102, "from": 0.02, "to": 1.0, "duration_ms": 2500, "steps": 50},
        {"op": "mark", "at_ms": 2700, "label": "high-damping"},
        {"op": "sweep_parameter", "at_ms": 2900, "id": 102, "from": 1.0, "to": 0.10, "duration_ms": 2100, "steps": 42},
        {"op": "mark", "at_ms": 5000, "label": "low-damping"},
        {"op": "note_off", "at_ms": 5400, "note": 60},
        {"op": "panic", "at_ms": 6300}
      ]
    },
    {
      "id": "A04",
      "name": "Feedback sweep",
      "preset": "feedback",
      "duration_ms": 6500,
      "expected": "Observable transition through regenerative/self-sustaining states followed by controlled recovery.",
      "program": [
        {"op": "note_on", "at_ms": 0, "note": 60, "velocity": 0.65},
        {"op": "sweep_parameter", "at_ms": 300, "id": 103, "from": 0.0, "to": 1.50, "duration_ms": 3300, "steps": 66},
        {"op": "mark", "at_ms": 3500, "label": "maximum-feedback"},
        {"op": "set_parameter", "at_ms": 3800, "id": 105, "value": 0.0},
        {"op": "note_off", "at_ms": 3800, "note": 60},
        {"op": "sweep_parameter", "at_ms": 4100, "id": 103, "from": 1.50, "to": 0.15, "duration_ms": 1500, "steps": 30},
        {"op": "mark", "at_ms": 5700, "label": "recovery"},
        {"op": "panic", "at_ms": 6400}
      ]
    },
    {
      "id": "A05",
      "name": "C2-C6 pitch run",
      "preset": "neutral",
      "duration_ms": 30200,
      "expected": "All notes C2-C6 render finitely; each note is held long enough for the Lab F0 analyser to settle before target-frequency and cents-error evidence is marked.",
      "program": [
        {"op": "pitch_run", "at_ms": 0, "start_midi": 36, "end_midi": 84, "note_ms": 500, "gap_ms": 100, "settle_ms": 350, "velocity": 0.78}
      ]
    },
    {
      "id": "A06",
      "name": "Velocity response",
      "preset": "pluck",
      "duration_ms": 4500,
      "expected": "Velocity 16-127 produces an observable, bounded excitation/loudness response with measurements captured per step.",
      "program": [
        {"op": "velocity_run", "at_ms": 0, "note": 60, "values": [16, 32, 48, 64, 80, 96, 112, 127], "note_ms": 330, "gap_ms": 200, "settle_ms": 150}
      ]
    },
    {
      "id": "A07",
      "name": "Chord and polyphony",
      "preset": "sustained-pipe",
      "duration_ms": 5800,
      "expected": "1/2/4/8 voices allocate deterministically, remain bounded and expose CPU/peak scaling without stuck voices.",
      "program": [
        {"op": "polyphony_run", "at_ms": 0, "counts": [1, 2, 4, 8], "notes": [48, 52, 55, 60, 64, 67, 72, 76], "stage_ms": 1000, "gap_ms": 350, "velocity": 0.68}
      ]
    },
    {
      "id": "A08",
      "name": "Self-oscillation",
      "preset": "feedback",
      "duration_ms": 5900,
      "expected": "Self-sustaining behaviour may emerge, remains bounded, responds to parameters and recovers when feedback is reduced.",
      "program": [
        {"op": "set_parameter", "at_ms": 0, "id": 103, "value": 1.35},
        {"op": "set_parameter", "at_ms": 0, "id": 105, "value": 0.20},
        {"op": "note_on", "at_ms": 0, "note": 57, "velocity": 0.70},
        {"op": "set_parameter", "at_ms": 800, "id": 105, "value": 0.0},
        {"op": "note_off", "at_ms": 800, "note": 57},
        {"op": "mark", "at_ms": 2800, "label": "self-sustain"},
        {"op": "set_parameter", "at_ms": 3600, "id": 103, "value": 0.15},
        {"op": "mark", "at_ms": 4800, "label": "recovery"},
        {"op": "panic", "at_ms": 5800}
      ]
    },
    {
      "id": "A09",
      "name": "Extreme stability",
      "preset": "extreme",
      "duration_ms": 7200,
      "expected": "Maximum-energy/polyphony/rapid-change stress remains finite; any protected state is reported; reset restores known-good silence.",
      "program": [
        {"op": "chord_on", "at_ms": 0, "notes": [48, 52, 55, 60, 64, 67, 72, 76], "velocity": 1.0},
        {"op": "sweep_parameter", "at_ms": 500, "id": 102, "from": 0.0, "to": 1.0, "duration_ms": 1500, "steps": 60},
        {"op": "sweep_parameter", "at_ms": 2100, "id": 102, "from": 1.0, "to": 0.0, "duration_ms": 1200, "steps": 48},
        {"op": "sweep_parameter", "at_ms": 500, "id": 103, "from": 1.50, "to": 0.25, "duration_ms": 1400, "steps": 56},
        {"op": "sweep_parameter", "at_ms": 2000, "id": 103, "from": 0.25, "to": 1.50, "duration_ms": 1300, "steps": 52},
        {"op": "rapid_retrigger", "at_ms": 3500, "notes": [36, 48, 60, 72, 84], "count": 30, "interval_ms": 70, "velocity": 1.0},
        {"op": "mark", "at_ms": 5900, "label": "extreme"},
        {"op": "panic", "at_ms": 6200},
        {"op": "reset", "at_ms": 6500},
        {"op": "mark", "at_ms": 6900, "label": "post-reset"}
      ]
    }
  ]
}
